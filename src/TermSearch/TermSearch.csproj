<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TermSearch</AssemblyName>
    <RootNamespace>TermSearch</RootNamespace>
    <!-- 跟 GitHub Release 的 tag（v0.1、v0.2、...）保持一致，Services/UpdateChecker.cs 用它
         和 GitHub 上最新 Release 的 tag 比较，判断要不要提示更新。每次发新 Release 前，记得
         把这里改成即将打的那个 tag 对应的号（比如要发 v0.3，这里就先改成 0.3）。 -->
    <Version>0.5.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 我们通过 app.manifest 声明 PerMonitorV2 DPI 感知（WPF 窗口定位依赖它），
         WinForms 分析器会建议改用 SetHighDpiMode API，但那只影响 WinForms 控件，这里用不到，忽略即可。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- 绿色版单文件发布设置：dotnet publish -c Release -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- CopyToOutputDirectory 只保证 dotnet build 会带上这两个文件；PublishSingleFile 场景下
         dotnet publish 的发布目录另有一套判断逻辑，观察到 terms.json（体积较大）有时不会
         被带进 publish\ 目录，因此显式加上 CopyToPublishDirectory 保证两个数据文件在发布产物里都在。 -->
    <None Update="terms.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
