<Window x:Class="TermSearch.HotkeySettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inp="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        Title="修改全局热键"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <StackPanel Margin="20">
        <TextBlock Text="请按下新的组合键" FontSize="14" Foreground="#FF1F2329"/>
        <TextBlock Text="需要包含至少一个 Ctrl / Alt / Shift / Win，再加一个按键"
                   FontSize="12" Foreground="#FF9AA0A6"
                   Margin="0,2,0,12" TextWrapping="Wrap"/>

        <TextBox x:Name="CaptureBox"
                 FontSize="18"
                 Padding="8,6"
                 IsReadOnly="True"
                 TextAlignment="Center"
                 Background="#FFF5F6F8"
                 BorderBrush="#FFD8DBE0"
                 BorderThickness="1"
                 inp:InputMethod.IsInputMethodEnabled="False"
                 PreviewKeyDown="CaptureBox_PreviewKeyDown"/>

        <TextBlock x:Name="ErrorText"
                   Foreground="#FFD64545"
                   FontSize="12"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="72" Height="28" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="保存" Width="72" Height="28" Click="SaveButton_Click" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
