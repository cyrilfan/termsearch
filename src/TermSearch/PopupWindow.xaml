<Window x:Class="TermSearch.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inp="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        Title="术语速查"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#FFD8DBE0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部拖拽条：无边框窗口没有系统标题栏，靠这条细带承担"按住拖动窗口"的功能；
                 保持透明、不画任何东西，避免破坏卡片外观，只用光标变化提示这里能拖动。 -->
            <Border Grid.Row="0" Background="Transparent" Cursor="SizeAll"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"/>

        <StackPanel Grid.Row="1" Margin="18,6,18,18">

            <TextBox x:Name="SearchBox"
                     FontSize="22"
                     Padding="4,2"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#FF1F2329"
                     CaretBrush="#FF2B6CE0"
                     inp:InputMethod.IsInputMethodEnabled="False"
                     TextChanged="SearchBox_TextChanged"/>

            <Rectangle Height="1" Fill="#FFE3E5E8" Margin="0,10,0,0"/>

            <!-- 查询结果面板 -->
            <StackPanel x:Name="ResultsPanel" Margin="0,10,0,0">
                <TextBlock x:Name="HintText"
                           Text="暂未添加，待补充（按 Enter 立即添加）"
                           Foreground="#FF9AA0A6"
                           FontSize="14"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <ListBox x:Name="ResultsList"
                         MaxHeight="320"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="Collapsed">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFEAF1FD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding KeySegments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text, Mode=OneWay}" FontSize="16" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FF1F2329"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FF2B6CE0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text=" — " FontSize="16" FontWeight="SemiBold" Foreground="#FF1F2329"/>
                                    <TextBlock Text="{Binding Entry.FullName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="#FF1F2329"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Entry.Description, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="#FF6B7075"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding DescriptionVisibility, Mode=OneWay}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="AddVariantHintText"
                           FontSize="12"
                           Foreground="#FF9AA0A6"
                           Margin="0,6,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- 快捷补充/编辑面板：新增词条和编辑已有词条共用同一套输入框，见 PopupWindow.xaml.cs 里的 _isEditMode。 -->
            <StackPanel x:Name="AddPanel" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="AddPanelTitle" Text="补充术语" FontSize="14" Foreground="#FF6B7075"/>

                <TextBlock Text="缩写" FontSize="12" Foreground="#FF9AA0A6" Margin="0,10,0,2"/>
                <TextBox x:Name="AddKeyBox" FontSize="16" Padding="6,4"
                         BorderBrush="#FFD8DBE0" BorderThickness="1"
                         inp:InputMethod.IsInputMethodEnabled="False"
                         KeyDown="AddKeyBox_KeyDown"/>

                <TextBlock Text="全称" FontSize="12" Foreground="#FF9AA0A6" Margin="0,8,0,2"/>
                <TextBox x:Name="FullNameBox" FontSize="16" Padding="6,4"
                         BorderBrush="#FFD8DBE0" BorderThickness="1"
                         inp:InputMethod.IsInputMethodEnabled="False"
                         KeyDown="FullNameBox_KeyDown"/>

                <TextBlock Text="解释" FontSize="12" Foreground="#FF9AA0A6" Margin="0,8,0,2"/>
                <TextBox x:Name="DescriptionBox" FontSize="16" Padding="6,4"
                         BorderBrush="#FFD8DBE0" BorderThickness="1"
                         KeyDown="DescriptionBox_KeyDown"/>

                <TextBlock x:Name="AddPanelFooter" Text="按 Enter 保存，Esc 取消并关闭"
                           FontSize="12" Foreground="#FF9AA0A6" Margin="0,8,0,0"/>
            </StackPanel>

        </StackPanel>
        </Grid>
    </Border>
</Window>
