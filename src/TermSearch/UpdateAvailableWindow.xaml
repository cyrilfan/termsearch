<Window x:Class="TermSearch.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">

    <StackPanel Margin="20">
        <TextBlock x:Name="VersionText" FontSize="14" Foreground="#FF1F2329" TextWrapping="Wrap"/>

        <TextBlock Text="更新说明" FontSize="12" Foreground="#FF9AA0A6" Margin="0,14,0,4"/>
        <Border BorderBrush="#FFD8DBE0" BorderThickness="1" Background="#FFF5F6F8" MaxHeight="220">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                <TextBlock x:Name="ReleaseNotesText" FontSize="13" Foreground="#FF444B52" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText"
                   FontSize="12"
                   Foreground="#FF9AA0A6"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LaterButton" Content="以后再说" Width="88" Height="28" Margin="0,0,8,0" Click="LaterButton_Click"/>
            <Button x:Name="UpdateButton" Content="立即更新" Width="88" Height="28" Click="UpdateButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
